{
  "name": "handproof",
  "version": "0.0.1",
  "description": "A typed, verifiable handoff contract between coding agents over MCP",
  "license": "MIT",
  "author": "muratbekj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muratbekj/handproof.git"
  },
  "homepage": "https://github.com/muratbekj/handproof#readme",
  "bugs": {
    "url": "https://github.com/muratbekj/handproof/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents",
    "handoff",
    "claude-code",
    "cursor",
    "coding-agents"
  ],
  "type": "module",
  "bin": {
    "handproof": "bin/handproof.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "bun build src/bin.ts --target=bun --outdir dist",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "picomatch": "4.0.7",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/bun": "1.4.4",
    "@types/picomatch": "4.0.3",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
